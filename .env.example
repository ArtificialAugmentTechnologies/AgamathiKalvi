# Copy to `.env` in the repo root. Both the API and the web app read this one file.
# Never commit `.env`.

# ---------- Server ----------
NODE_ENV=development
PORT=4000
# PostgreSQL on Neon (neon.tech → your project → Connect). Both strings come from that screen:
#   DATABASE_URL = the POOLED string (host contains "-pooler")  — used by the app
#   DIRECT_URL   = the DIRECT string (same host without "-pooler") — used by migrations
# Keep both secret. They must end with ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/agamathi?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/agamathi?sslmode=require
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Where uploaded files are stored (local driver)
UPLOAD_DIR=uploads
# First admin account created by the seed script
SEED_ADMIN_EMAIL=admin@agamathikalvi.com
SEED_ADMIN_PASSWORD=ChangeMe@123

# ---------- Client (must start with VITE_ to reach the browser) ----------
VITE_API_URL=/api
VITE_SITE_URL=http://localhost:5173
VITE_WHATSAPP_NUMBER=919789288421
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (leave empty to disable)
VITE_GA4_ID=


